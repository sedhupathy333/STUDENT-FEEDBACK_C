#include <stdio.h>

int main()
{
    FILE *fp;

    // Step 1: Open the file in write mode
    fp = fopen("Feedback.txt", "w");

    if (fp == NULL)
    {
        printf("File opening failed\n");
        return 0;
    }

    // Step 2: Write feedback into the file
    fprintf(fp, "About the C Programming Feedback\n");

    fprintf(fp, "1. Learned the basics of C programming easily.\n");
    fprintf(fp, "2.Gained confidence in writing C programs.\n");
    fprintf(fp, "3. C programming concepts were explained clearly.\n");
    fprintf(fp, "4. File handling is an interesting topic.\n");
    fprintf(fp, "5. C is used to develop software and applications.\n");

    // Step 3: Close the file
    fclose(fp);

    // Step 4: Open the file in append mode
    fp = fopen("Feedback.txt", "a");

    if (fp == NULL)
    {
        printf("File opening failed\n");
        return 0;
    }

    // Step 5: Add additional feedback
    fprintf(fp, "\nOwn Feedback\n");
    fprintf(fp, "The trainer helped us improve our problem-solving skills.\n");
    fprintf(fp, "I understand C programming better.\n");
    fprintf(fp, "The trainer explained C programming concepts clearly.\n");
    fprintf(fp,"The trainer explained programs with real-time examples.\n");
    fprintf( fp,"The trainer helped us improve our problem-solving skills.\n");

    // Step 6: Close the file
    fclose(fp);

    // Step 7: Open the file in read mode
    fp = fopen("Feedback.txt", "r");

    if (fp == NULL)
    {
        printf("File opening failed\n");
        return 0;
    }

    // Step 8: Read and display the file content
    char buffer[300];

    printf("\n----- Feedback Content -----\n");

    while (fgets(buffer, sizeof(buffer), fp) != NULL)
    {
        printf("%s", buffer);
    }

    // Step 9: Close the file
    fclose(fp);

    printf("\n\nFeedback added and displayed successfully.\n");

    return 0;
}
